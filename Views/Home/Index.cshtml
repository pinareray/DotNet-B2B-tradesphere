@{
    ViewData["Title"] = "Anasayfa";
}

<div class="text-center mt-5">
    <h1 class="display-4 fw-bold">TradeSphere B2B Portalına Hoş Geldiniz</h1>
    <p class="lead mt-3">Kurumsal müşterilerimiz için tasarlanmış yeni nesil sipariş ve bayi yönetim sistemi.</p>
    
    <div class="row mt-5">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Dinamik İskontolar</h5>
                    <p class="card-text">Cari hesaplarınıza özel tanımlanmış indirim oranlarıyla sipariş verin.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Hızlı Sipariş</h5>
                    <p class="card-text">Excel üzerinden veya toplu sepet özelliğiyle saniyeler içinde sipariş oluşturun.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Cari Takibi</h5>
                    <p class="card-text">Tüm geçmiş siparişlerinizi, ödemelerinizi ve bakiyenizi anlık görüntüleyin.</p>
                </div>
            </div>
        </div>
    </div>
</div>