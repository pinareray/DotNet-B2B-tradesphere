<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - TradeSphere B2B</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <nav class="navbar navbar-expand-lg ts-navbar mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">
                Trade<span>Sphere</span>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            <i class="bi bi-grid-1x2-fill"></i>Anasayfa
                        </a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Product" asp-action="Index">
                                <i class="bi bi-box-seam"></i>Ürünler
                            </a>
                        </li>
                        <li class="nav-item">
                            @await Component.InvokeAsync("CartSummary")
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Order" asp-action="History">
                                <i class="bi bi-receipt"></i>Siparişlerim
                            </a>
                        </li>
                        <li class="nav-item">
                            <span class="nav-link ts-user-badge">
                                <i class="bi bi-person-circle"></i>
                                <strong>@User.Identity.Name</strong>
                            </span>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-light btn-sm ms-lg-1">
                                    <i class="bi bi-box-arrow-right"></i> Çıkış
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-outline-light btn-sm ms-lg-2" asp-controller="Auth" asp-action="Login">
                                <i class="bi bi-shield-lock"></i> Bayi Girişi
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="ts-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="ts-footer-brand">Trade<span>Sphere</span></div>
                    <p class="mt-2 mb-0 small">Kurumsal B2B sipariş ve bayi yönetim platformu.</p>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white fw-semibold mb-3">Hızlı Erişim</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-right me-1"></i>Dashboard</a></li>
                        <li class="mb-2"><a asp-controller="Product" asp-action="Index"><i class="bi bi-chevron-right me-1"></i>Ürün Kataloğu</a></li>
                        <li class="mb-2"><a asp-controller="Auth" asp-action="Login"><i class="bi bi-chevron-right me-1"></i>Bayi Girişi</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white fw-semibold mb-3">Destek</h6>
                    <p class="small mb-1"><i class="bi bi-envelope me-2"></i>destek@tradesphere.com</p>
                    <p class="small mb-0"><i class="bi bi-telephone me-2"></i>+90 (212) 000 00 00</p>
                </div>
            </div>
            <div class="ts-footer-bottom text-center">
                &copy; 2026 Pınar Eray — TradeSphere B2B Platform. Tüm hakları saklıdır.
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)

    @if (TempData["AlertMessage"] is string alertMessage)
    {
        var alertTitle = TempData["AlertTitle"]?.ToString() ?? "Bildirim";
        var alertType = TempData["AlertType"]?.ToString() ?? "info";
        <script>
            Swal.fire({
                title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(alertTitle)),
                text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(alertMessage)),
                icon: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(alertType)),
                confirmButtonText: 'Tamam',
                confirmButtonColor: '#1e3a5f'
            });
        </script>
    }
    @if (User.IsInRole("Admin"))
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
        <script>
            const orderConnection = new signalR.HubConnectionBuilder()
                .withUrl("/orderHub")
                .withAutomaticReconnect()
                .build();

            orderConnection.on("ReceiveNewOrder", (message) => {
                Swal.fire({
                    toast: true,
                    position: "top-end",
                    icon: "success",
                    title: "Yeni Sipariş",
                    text: message,
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
            });

            orderConnection.start().catch((err) => console.error("SignalR bağlantı hatası:", err));
        </script>
    }
</body>
</html>
