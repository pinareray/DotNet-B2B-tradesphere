<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - TradeSphere B2B</title>
    
    <!-- Bootstrap CSS (CDN üzerinden) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Kendi yazdığımız özel CSS (Tilde ~ işareti doğrudan wwwroot klasörünü işaret eder) -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="bg-light">

    <!-- Üst Menü (Navbar) -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">TradeSphere</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="/">Anasayfa</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#">Bayi Girişi</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Dinamik İçerik Alanı -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Alt Bilgi (Footer) -->
    <footer class="border-top footer text-muted mt-5 py-3 bg-white">
        <div class="container text-center">
            &copy; 2026 - Pınar Eray | B2B TradeSphere
        </div>
    </footer>

    <!-- Bootstrap JS (CDN üzerinden) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
</body>
</html>