@model int

<a class="btn btn-outline-light btn-sm position-relative ms-lg-2" asp-controller="Cart" asp-action="Index">
    Sepet
    @if (Model > 0)
    {
        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
            @Model
        </span>
    }
</a>
