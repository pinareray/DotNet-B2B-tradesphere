<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - TradeSphere Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin.css" />
</head>
<body class="admin-body">

<div class="admin-wrapper">
    <aside class="admin-sidebar">
        <div class="admin-brand px-3 py-4">
            <span class="brand-icon"><i class="bi bi-shield-lock-fill"></i></span>
            <div>
                <strong>TradeSphere</strong>
                <small class="d-block text-white-50">Admin Panel</small>
            </div>
        </div>

        <nav class="admin-nav flex-column px-2">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
               class="admin-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            <a asp-area="" asp-controller="Product" asp-action="Index" class="admin-nav-link">
                <i class="bi bi-box-seam"></i> Ürün Yönetimi
            </a>
            <a asp-area="" asp-controller="Dealer" asp-action="Index" class="admin-nav-link">
                <i class="bi bi-building"></i> Bayiler
            </a>
            <hr class="border-secondary my-3 mx-2" />
            <a asp-area="" asp-controller="Home" asp-action="Index" class="admin-nav-link">
                <i class="bi bi-box-arrow-up-right"></i> Siteye Dön
            </a>
        </nav>

        <div class="admin-sidebar-footer px-3 py-3 mt-auto">
            <div class="text-white-50 small mb-2">
                <i class="bi bi-person-badge me-1"></i>@User.Identity?.Name
            </div>
            <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-light btn-sm w-100">
                    <i class="bi bi-box-arrow-right me-1"></i>Çıkış
                </button>
            </form>
        </div>
    </aside>

    <div class="admin-main">
        <header class="admin-topbar">
            <div>
                <h1 class="admin-page-title mb-0">@ViewData["Title"]</h1>
                <small class="text-muted">Yönetim merkezi</small>
            </div>
            <span class="badge admin-badge-live">
                <i class="bi bi-circle-fill me-1"></i>Canlı
            </span>
        </header>

        <main class="admin-content">
            @RenderBody()
        </main>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)

@if (User.IsInRole("Admin"))
{
    <script>
        const orderConnection = new signalR.HubConnectionBuilder()
            .withUrl("/orderHub")
            .withAutomaticReconnect()
            .build();

        orderConnection.on("ReceiveNewOrder", (message) => {
            Swal.fire({
                toast: true,
                position: "top-end",
                icon: "success",
                title: "Yeni Sipariş",
                text: message,
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true
            });
        });

        orderConnection.start().catch((err) => console.error("SignalR:", err));
    </script>
}

</body>
</html>
